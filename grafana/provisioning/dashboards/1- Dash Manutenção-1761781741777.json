            "resultReuseEnabled": false,
            "resultReuseMaxAgeInMinutes": 60
          },
          "format": 1,
          "rawSQL": "SELECT \r\n  date_format(parse_datetime(t.timestamp, 'yyyy-MM-dd HH:mm:ss'), '%d/%m/%Y %H:%i:%s') AS \"Data e Hora\",\r\n  t.train_id AS \"ID do trem\",\r\n  t.brake_pad_id AS \"ID do Brake Pad\",\r\n  CAST(t.brake_pad_mm AS DOUBLE) AS \"Valor do Brake Pad (mm)\",\r\n  CAST(t.sla_status AS VARCHAR(255)) AS \"Status da Pastilha\"\r\nFROM table_optico t\r\nINNER JOIN (\r\n    SELECT \r\n        brake_pad_id,\r\n        MAX(parse_datetime(timestamp, 'yyyy-MM-dd HH:mm:ss')) AS ultimo_timestamp\r\n    FROM table_optico\r\n    WHERE train_id IN (${carro:csv})\r\n    GROUP BY brake_pad_id\r\n) ult ON t.brake_pad_id = ult.brake_pad_id\r\n     AND parse_datetime(t.timestamp, 'yyyy-MM-dd HH:mm:ss') = ult.ultimo_timestamp\r\nWHERE t.train_id IN (${carro:csv})\r\nORDER BY t.brake_pad_mm ASC;\r\n",
          "refId": "A"
        }
      ],
