            {
              "connectionArgs": {
                "catalog": "__default",
                "database": "__default",
                "region": "__default",
                "resultReuseEnabled": false,
                "resultReuseMaxAgeInMinutes": 60
              },
              "format": 1,
              "rawSQL": "WITH surtos_por_passagem AS (\r\n    SELECT \r\n        TRY_CAST(p.headway AS DOUBLE) AS headway_valor,\r\n        COUNT(d.datahora) AS qtd_surtos\r\n    FROM bypass_table_piezo p\r\n    LEFT JOIN bypass_table_dps d\r\n        ON d.corrente_surto_ka != 0\r\n        AND date_parse(d.datahora, '%Y-%m-%d %H:%i:%s')\r\n            BETWEEN date_parse(p.data_hora_inicio, '%Y-%m-%d %H:%i:%s')\r\n            AND date_parse(p.data_hora_fim, '%Y-%m-%d %H:%i:%s')\r\n    GROUP BY p.headway\r\n)\r\nSELECT \r\n    ROUND(corr(headway_valor, qtd_surtos), 2) AS coef_correlacao\r\nFROM surtos_por_passagem\r\nWHERE headway_valor IS NOT NULL;\r\n",
              "refId": "A"
            }
          ],
          "title": "Relação entre Surtos Elétricos e Atrasos",
          "type": "stat"
        },
