                "resultReuseMaxAgeInMinutes": 60
              },
              "format": 1,
              "rawSQL": "SELECT\r\n    date_format(\r\n        date_parse(data_hora_inicio, '%Y-%m-%d %H:%i:%s'),\r\n        '%d/%m/%Y %H:%i:%s'\r\n    ) AS \"Data hora - Inicio\",\r\n    trilho AS \"Trilho\",\r\n    TRY_CAST(pressao_kpa AS DOUBLE) AS \"Pressão (kPa)\",\r\n    TRY_CAST(headway AS DOUBLE) AS \"Headway(s)\"\r\nFROM bypass_table_piezo\r\nWHERE TRY_CAST(pressao_kpa AS DOUBLE) >= 650\r\n  AND TRY_CAST(headway AS DOUBLE) >= 350\r\n  AND date_parse(data_hora_inicio, '%Y-%m-%d %H:%i:%s') \r\n        BETWEEN timestamp '2025-06-16 00:00:00'\r\n            AND timestamp '2025-06-16 23:59:59'\r\nORDER BY date_parse(data_hora_inicio, '%Y-%m-%d %H:%i:%s');\r\n",
              "refId": "A"
            }
          ],
          "title": "Eventos com Pressão Elevada e/ou Atraso",
          "type": "table"
