          "format": 1,
          "rawSQL": "SELECT\r\n    CONCAT('Trem ', trem_id, ' - Carro ', carro_id) AS label,\r\n    ROUND(\r\n        CASE \r\n            WHEN carro_id = '1' \r\n                THEN (\r\n                    (COUNT(CASE WHEN CAST(REPLACE(dist, ',', '') AS DOUBLE) < 1750 THEN 1 END) * 100.0 /\r\n                     NULLIF(COUNT(*), 0)\r\n                    ) - 20\r\n                )\r\n            ELSE (\r\n                    COUNT(CASE WHEN CAST(REPLACE(dist, ',', '') AS DOUBLE) < 1750 THEN 1 END) * 100.0 /\r\n                    NULLIF(COUNT(*), 0)\r\n                )\r\n        END,\r\n        2\r\n    ) AS taxa_ocupacao_percent\r\nFROM bypass_table_tof\r\nWHERE trem_id = CAST(${trem:csv} AS VARCHAR)\r\nGROUP BY trem_id, carro_id\r\nORDER BY carro_id;\r\n",
