          },
          "format": 1,
          "rawSQL": "WITH x_values AS (\r\n    SELECT CAST(n AS INT) AS x\r\n    FROM UNNEST(SEQUENCE(0,6)) AS t(n)\r\n),\r\ny_values AS (\r\n    SELECT CAST(n AS INT) AS y\r\n    FROM UNNEST(SEQUENCE(0,24)) AS t(n)\r\n)\r\nSELECT\r\n    x_values.x,\r\n    y_values.y,\r\n    CAST(REPLACE(t.dist, ',', '') AS DOUBLE) AS valorMatriz,\r\n    current_timestamp AS __time\r\nFROM x_values\r\nCROSS JOIN y_values\r\nLEFT JOIN bypass_table_tof t\r\n    ON t.x_block = x_values.x\r\n   AND t.y_block = y_values.y\r\n   AND t.trem_id = CAST(${trem:csv} AS VARCHAR)\r\n   AND t.carro_id = CAST(${carro:csv} AS VARCHAR)\r\nWHERE t.dist IS NOT NULL AND t.dist <> ''\r\nORDER BY x_values.x, y_values.y;\r\n",
          "refId": "A"
        }
      ],
      "title": "Painel Trem ${trem} - Carro ${carro}",
      "type": "boazreicher-mosaicplot-panel"
    }
