          "format": 1,
          "rawSQL": "WITH base AS (\r\n    SELECT \r\n        AVG(TRY_CAST(headway AS DOUBLE)) AS media_intervalo\r\n    FROM bypass_table_piezo\r\n    WHERE hour(date_parse(data_hora_inicio, '%Y-%m-%d %H:%i:%s')) BETWEEN 12 AND 17\r\n)\r\nSELECT \r\n    CASE\r\n        WHEN ABS(media_intervalo) <= 180 THEN 0\r\n        WHEN ABS(media_intervalo) <= 360 THEN 1\r\n        ELSE 2\r\n    END AS classificacao_intervalo_num\r\nFROM base;\r\n",
          "refId": "A"
        }
      ],
